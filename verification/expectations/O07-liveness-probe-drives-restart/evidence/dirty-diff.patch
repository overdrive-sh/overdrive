+        fn tick_at(counter: u64) -> TickContext {
+            let now = Instant::now();
+            TickContext {
+                now,
+                now_unix: UnixInstant::from_unix_duration(Duration::from_secs(
+                    1_700_000_000 + counter,
+                )),
+                tick: counter,
+                deadline: now + Duration::from_secs(1),
+            }
+        }
