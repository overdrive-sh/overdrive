2026-11-28T11:36:21.562Z [spec] $ cat /home/ubuntu/overdrive-worktrees/7b8ff0c72f245ec096bece5af30fe7b78dfc85860ccff18379926b83e3c1eac6/verification/expectations/E17-vm-guest-resolves-public-names-through-its-default-resolver/herdr-box.toml
    # The herdr dev box's lookup targets, resolved from a VM guest through its
    # default resolver (E17). A finite VM Job: the guest program looks each name up
    # with getaddrinfo, opens a bare TCP connection to the first resolved IPv4
    # address on 443, then looks up one name that does not exist, and exits.
    [job]
    id = "herdr-box"
    
    [vm]
    command = "/opt/overdrive/examples/svm/overdrive-guest-peer"
    args = [
      "resolve-tcp-connect", "443",
      "api.anthropic.com", "github.com", "crates.io", "herdr.dev",
      "no-such-host-7f3a.example.com",
    ]
    kernel = "/srv/vm/overdrive-testing/svm-e08/kernel"
    rootfs = "/srv/vm/overdrive-testing/svm-e08/rootfs.ext4"
    
    [resources]
    cpu = "500m"
    memory = "128MiB"
