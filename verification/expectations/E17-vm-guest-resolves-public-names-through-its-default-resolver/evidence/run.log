[spec] $ cat /home/ubuntu/overdrive-worktrees/7b8ff0c72f245ec096bece5af30fe7b78dfc85860ccff18379926b83e3c1eac6/verification/expectations/E17-vm-guest-resolves-public-names-through-its-default-resolver/herdr-box.toml
# The herdr dev box's lookup targets, resolved from a VM guest through its
# default resolver (E17). A finite VM Job: the guest program looks each name up
# with getaddrinfo, opens a bare TCP connection to the first resolved IPv4
# address on 443, then looks up one name that does not exist, and exits.
[job]
id = "herdr-box"

[vm]
command = "/opt/overdrive/examples/svm/overdrive-guest-peer"
args = [
  "resolve-tcp-connect", "443",
  "api.anthropic.com", "github.com", "crates.io", "herdr.dev",
  "no-such-host-7f3a.invalid",
]
kernel = "/srv/vm/overdrive-testing/svm-e08/kernel"
rootfs = "/srv/vm/overdrive-testing/svm-e08/rootfs.ext4"

[resources]
cpu = "500m"
memory = "128MiB"
[spec] exit=0
[host-nft-before] $ nft list ruleset
table ip overdrive-mtls {
	set inbound_destinations {
		type ipv4_addr . inet_service
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		meta mark 0x00000002 accept
		ip daddr . tcp dport @inbound_destinations meta mark set 0x00000001 tproxy to 127.0.0.1:42399 accept
		ip daddr 100.95.0.0/16 ip daddr != 100.95.0.1 drop
	}

	chain output {
		type route hook output priority mangle; policy accept;
		meta mark & 0x00000004 == 0x00000004 ip daddr 100.95.0.1 udp dport 53 accept
		meta mark & 0x00000004 == 0x00000004 ip daddr 100.95.0.1 tcp dport 53 accept
		meta mark & 0x00000004 == 0x00000004 ip daddr 127.0.0.0/8 reject
		meta mark & 0x00000004 == 0x00000004 ip daddr 169.254.0.0/16 reject
		meta mark & 0x00000004 == 0x00000004 fib daddr type != unicast reject
		meta mark 0x00000002 accept
		ip daddr . tcp dport @inbound_destinations meta mark != 0x00000002 meta mark set 0x00000001 accept
		ip daddr 100.95.0.0/16 ip daddr != 100.95.0.1 reject with tcp reset
		ip daddr 100.95.0.0/16 ip daddr != 100.95.0.1 reject
	}
}
