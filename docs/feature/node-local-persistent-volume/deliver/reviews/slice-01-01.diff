+                .wrap_err_with(|| format!("clearing stale {}", path.display()))?;
+        }
+    }
+    if lvm_dir.exists() {
+        std::fs::remove_dir_all(&lvm_dir)
+            .wrap_err_with(|| format!("clearing {}", lvm_dir.display()))?;
