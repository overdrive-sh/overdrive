commit a3ea0cf01c924cf6a1522d0f4120a093ed57c5de
Author: Marcus Schack Abildskov <work@marcus-sa.dev>
Date:   Fri Nov 20 20:37:38 2026 +0100

    feat(node-local-persistent-volume): add [vm.volume] spec surface and workload intent envelope V2
    
    Declare the volume on the VM spec, project it through Vm::to_payload at the
    three reconciler sites, and bump the workload intent envelope to V2 with
    V1 frozen as an explicit fixture. Retarget the dependent pending markers to
    their next RED.
    
    Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
    Step-Id: 02-02
    Task-Id: node-local-persistent-volume

diff --git a/api/openapi.yaml b/api/openapi.yaml
index eb528bcb3..637ef2849 100644
--- a/api/openapi.yaml
+++ b/api/openapi.yaml
@@ -4006,9 +4006,8 @@ components:
         Operator-facing `[vm]` table fields (ADR-0082 / ADR-0083, GH #42).
         Mirrors the runtime `traits::driver::VmPayload` shape — `String`,
         not `PathBuf`, for both `kernel` and `rootfs` (serde-clean wire
-        shape). Per-VM volumes are out
-        of scope for this feature (deferred to overdrive-fs, GH #97 /
-        virtiofsd, GH #43).
+        shape). The optional `volume` is the workload's node-local persistent
+        volume (GH #348, ADR-0310).
       required:
       - command
       - args
@@ -4029,6 +4028,24 @@ components:
         rootfs:
           type: string
           description: Operator-supplied rootfs artifact path (BYO).
+        volume:
+          oneOf:
+          - type: 'null'
+          - $ref: '#/components/schemas/VmVolumeInput'
+            description: The `[vm.volume]` declaration, when the workload has one.
+      additionalProperties: false
+    VmVolumeInput:
+      type: object
+      description: |-
+        The `[vm.volume]` table (GH #348, ADR-0310): one field, `size`, validated
+        as a [`crate::volume::VolumeSize`] at admission. `deny_unknown_fields`
+        refuses every other key.
+      required:
+      - size
+      properties:
+        size:
+          type: string
+          description: The declared size, `<uint>GiB` or `<uint>TiB`.
       additionalProperties: false
     VolumeOperation:
       type: string
