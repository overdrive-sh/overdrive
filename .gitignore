# Local-only conductor scratch
.context/

# nw-spike probes. Sources, scripts and captured evidence ARE committed and
# live until the implementation supersedes them (user ruling 2026-08-11) — a
# probe's evidence is the only record of how a measured claim was obtained, and
# `findings.md` quotes only extracts. Build output is not committed.
spike-scratch/*/target/
spike-scratch/*/out/
spike-scratch/.nwave/

# Lefthook — per-dev overrides
lefthook-local.yml
.lefthook-local.yml

# Secrets — xtask mcp setup writes .mcp.json from .env
.env
.mcp.json

# Bun / TS tooling for scripts/
/node_modules/

.claude/scheduled_tasks.lock
# nWave activation marker (keep .nwave/local-config.json trackable)
.nwave/*
!.nwave/local-config.json
