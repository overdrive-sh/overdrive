  700     #[expect(clippy::too_many_arguments)]
  701     pub fn from_tap_fds(
  702         id: String,
  703         fds: &[RawFd],
  704         guest_mac: Option<MacAddr>,
  705         mtu: Option<u16>,
  706         access_platform_enabled: bool,
  707         queue_size: u16,
  708         seccomp_action: SeccompAction,
  709         rate_limiter_config: Option<RateLimiterConfig>,
  710         exit_evt: EventFd,
  711         state: Option<NetState>,
  712         offload_tso: bool,
  713         offload_ufo: bool,
  714         offload_csum: bool,
  715     ) -> Result<Self> {
  716         let mut taps: Vec<Tap> = Vec::new();
  717         let num_queue_pairs = fds.len();
  718 
  719         for fd in fds.iter() {
  720             // Duplicate so that it can survive reboots
  721             // SAFETY: FFI call to dup. Trivially safe.
  722             let fd = unsafe { libc::dup(*fd) };
  723             if fd < 0 {
  724                 return Err(Error::DuplicateTapFd(io::Error::last_os_error()));
  725             }
  726             let tap = Tap::from_tap_fd(fd, num_queue_pairs).map_err(Error::TapError)?;
  727             taps.push(tap);
  728         }
  729 
  730         assert!(!taps.is_empty());
  731 
  732         if let Some(mtu) = mtu {
  733             taps[0].set_mtu(mtu as i32).map_err(Error::TapError)?;
  734         }
  735 
  736         Self::new_with_tap(
  737             id,
  738             taps,
  739             guest_mac,
  740             access_platform_enabled,
  741             num_queue_pairs * 2,
  742             queue_size,
  743             seccomp_action,
  744             rate_limiter_config,
  745             exit_evt,
  746             state,
  747             offload_tso,
  748             offload_ufo,
  749             offload_csum,
  750         )
  751     }
