  235     pub fn from_tap_fd(fd: RawFd, num_queue_pairs: usize) -> Result<Tap> {
  236         // Ensure that the file is opened non-blocking, this is particularly
  237         // needed when opened via the shell for macvtap.
  238         // SAFETY: FFI call
  239         let ret = unsafe {
  240             let mut flags = libc::fcntl(fd, libc::F_GETFL);
  241             flags |= libc::O_NONBLOCK;
  242             libc::fcntl(fd, libc::F_SETFL, flags)
  243         };
  244         if ret < 0 {
  245             return Err(Error::ConfigureTap(IoError::last_os_error()));
  246         }
  247 
  248         // SAFETY: fd is a tap fd
  249         let tap_file = unsafe { File::from_raw_fd(fd) };
  250         let mut ifreq: libc::ifreq = ifreq {
  251             ifr_name: [0; IFNAMSIZ],
  252             ifr_ifru: __c_anonymous_ifr_ifru { ifru_flags: 0 },
  253         };
  254 
  255         // Get current config including name
  256         // SAFETY: IOCTL with correct arguments
  257         unsafe { Self::ioctl_with_mut_ref(&tap_file, libc::TUNGETIFF as c_ulong, &mut ifreq)? };
  258 
  259         let if_name = {
  260             let ifr_ptr = ifreq.ifr_name.as_ptr();
  261             // SAFETY: The `ifr_name` field of the union is a valid, nul-terminated C string since it
  262             // was just set by the ioctl call, and we checked for errors.
  263             // We immediately convert the `CStr` to the owned `CString, so the memory of the union field
  264             // is not accessed or mutated during the lifetime of the `Cstr`.
  265             unsafe { CStr::from_ptr(ifr_ptr).to_owned() }
  266         };
  267 
  268         // Try and update flags. Depending on how the tap was created (macvtap
  269         // or via open_named()) this might return -EEXIST so we just ignore that.
  270         // SAFETY: access union fields
  271         unsafe {
  272             ifreq.ifr_ifru.ifru_flags =
  273                 (libc::IFF_TAP | libc::IFF_NO_PI | libc::IFF_VNET_HDR) as c_short;
  274             if num_queue_pairs > 1 {
  275                 ifreq.ifr_ifru.ifru_flags |= libc::IFF_MULTI_QUEUE as c_short;
  276             }
  277         }
  278         // SAFETY: IOCTL with correct arguments
  279         let ret = unsafe { ioctl_with_mut_ref(&tap_file, libc::TUNSETIFF as c_ulong, &mut ifreq) };
  280         if ret < 0 && IoError::last_os_error().raw_os_error().unwrap() != libc::EEXIST {
  281             return Err(Error::ConfigureTap(IoError::last_os_error()));
  282         }
  283 
  284         let tap = Tap { tap_file, if_name };
  285         let vnet_hdr_size = vnet_hdr_len() as i32;
  286         tap.set_vnet_hdr_size(vnet_hdr_size)?;
  287 
  288         Ok(tap)
  289     }
