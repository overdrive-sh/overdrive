#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
ip link set lo up
uname -a
cat /proc/sys/kernel/pid_max /proc/sys/kernel/threads-max
cat /sys/devices/system/cpu/online /sys/devices/system/cpu/possible
insmod /vsock.ko || poweroff -f
insmod /vhost_iotlb.ko || poweroff -f
insmod /vhost.ko || poweroff -f
insmod /vmw_vsock_virtio_transport_common.ko || poweroff -f
insmod /vhost_vsock.ko || poweroff -f
echo BENCH_PRE_VARIANT_MEMINFO
cat /proc/meminfo
echo BENCH_PRE_VARIANT_SLABINFO
cat /proc/slabinfo
echo BENCH_PRE_VARIANT_END
insmod /evmod.ko   || poweroff -f
echo BENCH_POST_LOAD_MEMINFO
cat /proc/meminfo
echo BENCH_POST_LOAD_END
echo BENCH_PERF_PMU_PROBE
/perf stat -a -e cycles,instructions -- sleep 0.1 2>&1
echo BENCH_PERF_SOFTWARE_PROBE
/perf stat -a -e cpu-clock,task-clock,context-switches,cpu-migrations -- sleep 0.1 2>&1
BENCH_REPEAT=0 /probe v3 v2t s3000,f 256 10 v2t-stall 40; /probe v3 v2t s10000,f 512 2 v2t-long 60; /probe v3 v2t r20 64 3 v2t-slow 60; /probe v3 v2t s1000,f:300,s1000,f:300,s1000,f 128 5 v2t-cyc 60; /probe v3 t2v s3000,f 64 10 t2v-stall 40; /probe v3 t2v s10000,f 64 2 t2v-long 60; /probe v3 t2v s1000,f:300,s1000,f:300,s1000,f 64 5 t2v-cyc 60
rc=$?
echo BENCH_HARNESS_EXIT=$rc
cat /proc/modules
if [ -e /proc/evmod ]; then rmmod evmod; fi
echo BENCH_MODULE_UNLOAD_EXIT=$?
echo BENCH_LIVE_MODULES_AFTER_UNLOAD
cat /proc/modules
dmesg | tail -60
echo BENCH_COMPLETE_EXIT=$rc
poweroff -f
