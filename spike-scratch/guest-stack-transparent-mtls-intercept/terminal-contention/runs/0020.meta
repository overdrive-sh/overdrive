command=OVERDRIVE_METAL_KERNEL=/srv/vm/overdrive-testing/kernel OVERDRIVE_METAL_ROOTFS=/srv/vm/overdrive-testing/rootfs.ext4 OVERDRIVE_METAL_SCENARIO=terminal-contention-final-post-cleanup cargo xtask metal run -- bash -lc 'set -euo pipefail; caller_scope=/sys/fs/cgroup/overdrive.slice/workloads.slice/alloc-gti-e07-caller-0.scope; callee_scope=/sys/fs/cgroup/overdrive.slice/workloads.slice/alloc-gti-e07-callee-0.scope; output=/srv/vm/overdrive-testing/gti-e07; netns=$(ip netns list); links=$(ip -o link show | grep -E "ovd-(hv|wl)-|(^|[[:space:]])tap[[:alnum:]_-]*[[:space:]@:]" || true); found=0; for p in /proc/[0-9]*; do [[ -e "$p/exe" ]] || continue; exe=$(readlink -f "$p/exe" 2>/dev/null || true); case "$exe" in /usr/local/bin/cloud-hypervisor|/srv/vm/overdrive-testing/gti-e07/bin/e07-callee) printf "unexpected pid=%s exe=%s\\n" "${p##*/}" "$exe"; found=1;; esac; done; printf "FINAL_POST_CLEANUP output=%s caller_scope=%s callee_scope=%s netns=%s alloc_links=%s exact_product_processes=%s\\n" "$([[ -e "$output" ]] && echo present || echo absent)" "$([[ -e "$caller_scope" ]] && echo present || echo absent)" "$([[ -e "$callee_scope" ]] && echo present || echo absent)" "$([[ -n "$netns" ]] && echo present || echo absent)" "$([[ -n "$links" ]] && echo present || echo absent)" "$([[ "$found" -eq 0 ]] && echo absent || echo present)"; [[ ! -e "$output" && ! -e "$caller_scope" && ! -e "$callee_scope" && -z "$netns" && -z "$links" && "$found" -eq 0 ]]; printf "FINAL_POST_CLEANUP verdict=clean\\n"'
