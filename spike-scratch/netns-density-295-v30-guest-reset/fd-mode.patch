+/// V-25 spike prototype: a vhost-vsock handle over a file the caller opened
+/// (and possibly already claimed a CID on).
+pub struct ClaimedVsock {
+    fd: std::fs::File,
+    mem: GuestMemoryAtomic<GuestMemoryMmap>,
+}
+
+impl AsRawFd for ClaimedVsock {
+    fn as_raw_fd(&self) -> std::os::unix::io::RawFd {
+        self.fd.as_raw_fd()
+    }
+}
+
+impl VhostKernBackend for ClaimedVsock {
+    type AS = GuestMemoryAtomic<GuestMemoryMmap>;
+    fn mem(&self) -> &Self::AS {
+        &self.mem
+    }
+}
+
+impl ClaimedVsock {
+    fn ioctl_val(&self, req: libc::c_ulong, arg: *const libc::c_void) -> vhost::Result<()> {
+        // SAFETY: valid fd, valid pointer to a live local, return value checked.
+        let ret = unsafe { libc::ioctl(self.fd.as_raw_fd(), req as _, arg) };
+        if ret < 0 {
+            Err(vhost::Error::IoctlError(std::io::Error::last_os_error()))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl VhostVsock for ClaimedVsock {
+    fn set_guest_cid(&self, cid: u64) -> vhost::Result<()> {
+        self.ioctl_val(0x4008_AF60, &cid as *const u64 as *const libc::c_void)
+    }
+    fn start(&self) -> vhost::Result<()> {
+        let on: libc::c_int = 1;
+        self.ioctl_val(0x4004_AF61, &on as *const _ as *const libc::c_void)
+    }
+    fn stop(&self) -> vhost::Result<()> {
+        let on: libc::c_int = 0;
+        self.ioctl_val(0x4004_AF61, &on as *const _ as *const libc::c_void)
     }
 }
