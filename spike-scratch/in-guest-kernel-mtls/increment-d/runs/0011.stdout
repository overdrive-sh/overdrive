--- full diff
diff --git a/lib/posix-socket/exportsyms.uk b/lib/posix-socket/exportsyms.uk
index ec00311c..e43e9caf 100644
--- a/lib/posix-socket/exportsyms.uk
+++ b/lib/posix-socket/exportsyms.uk
@@ -25,3 +25,5 @@ uk_socketpair_create
 uk_socket_accept
 uk_sys_socket
 uk_sys_socketpair
+uk_socket_connect_hook
+uk_socket_accept_hook
diff --git a/lib/posix-socket/include/uk/socket.h b/lib/posix-socket/include/uk/socket.h
index 8ff21f34..bc5d7c9b 100644
--- a/lib/posix-socket/include/uk/socket.h
+++ b/lib/posix-socket/include/uk/socket.h
@@ -62,6 +62,30 @@ struct posix_socket_node {
 
 #include <uk/socket_driver.h>
 
+struct uk_file;
+
+/**
+ * Connect post-hook (Overdrive GH #303 spike). Called by connect() after the
+ * address-family driver's connect has finished: ret is 0 for a completed
+ * (blocking) connect or -EINPROGRESS for a non-blocking one. The returned
+ * value replaces ret. The default weak definition returns ret unchanged; a
+ * library may provide a strong definition to act on the connected socket
+ * (e.g. hold it and swap its driver) before connect() returns to the caller.
+ */
+int uk_socket_connect_hook(const struct uk_file *sock,
+			   const struct sockaddr *addr, socklen_t addr_len,
+			   int blocking, int ret);
+
+/**
+ * Accept post-hook (Overdrive GH #303 spike). Called by accept()/accept4()
+ * for every accepted connection, after the address-family driver's accept
+ * and BEFORE the new socket gets a file descriptor. A non-zero (negative
+ * errno) return drops the connection and makes accept() fail with it. The
+ * default weak definition returns 0.
+ */
+int uk_socket_accept_hook(const struct uk_file *listener,
+			  const struct uk_file *sock, int blocking, int flags);
+
 struct uk_file *uk_socket_create(int family, int type, int protocol);
 
 int uk_socketpair_create(int family, int type, int protocol,
diff --git a/lib/posix-socket/socket.c b/lib/posix-socket/socket.c
index da4bd395..ea528865 100644
--- a/lib/posix-socket/socket.c
+++ b/lib/posix-socket/socket.c
@@ -370,6 +370,13 @@ const struct uk_file *uk_socket_accept(const struct uk_file *sock, int blocking,
 	return &al->f;
 }
 
+__weak int uk_socket_accept_hook(const struct uk_file *listener __unused,
+				 const struct uk_file *sock __unused,
+				 int blocking __unused, int flags __unused)
+{
+	return 0;
+}
+
 #if CONFIG_LIBPOSIX_FDTAB
 int uk_sys_accept(const struct uk_file *sock, int blocking,
 		  struct sockaddr *addr, socklen_t *addr_len, int flags)
@@ -384,6 +391,11 @@ int uk_sys_accept(const struct uk_file *sock, int blocking,
 	sockfile = uk_socket_accept(sock, blocking, addr, addr_len, flags);
 	if (unlikely(PTRISERR(sockfile)))
 		return PTR2ERR(sockfile);
+	fd = uk_socket_accept_hook(sock, sockfile, blocking, flags);
+	if (unlikely(fd)) {
+		uk_file_release(sockfile);
+		return fd;
+	}
 
 	if (flags & SOCK_NONBLOCK)
 		mode |= O_NONBLOCK;
@@ -655,6 +667,14 @@ out:
 	return ret;
 }
 
+__weak int uk_socket_connect_hook(const struct uk_file *sock __unused,
+				  const struct sockaddr *addr __unused,
+				  socklen_t addr_len __unused,
+				  int blocking __unused, int ret)
+{
+	return ret;
+}
+
 UK_TRACEPOINT(trace_posix_socket_connect, "%d %p %d",
 	      int, const struct sockaddr *, socklen_t);
 UK_TRACEPOINT(trace_posix_socket_connect_ret, "%d", int);
@@ -692,6 +712,9 @@ UK_SYSCALL_R_DEFINE(int, connect, int, sock, const struct sockaddr *, addr,
 					&ret, &_opsz);
 		uk_file_runlock(of->file);
 	}
+	if (ret == 0 || ret == -EINPROGRESS)
+		ret = uk_socket_connect_hook(of->file, addr, addr_len,
+					     _SHOULD_BLOCK(mode), ret);
 	uk_ofile_release(of);
 
