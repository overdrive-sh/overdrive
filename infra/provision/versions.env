# Pinned provisioning inputs for the bare-metal probe box.
#
# Consumed by infra/provision/common-system.sh and common-user.sh.
#
# It is NOT read by infra/lima/overdrive-dev.yaml — Lima keeps its own `param:`
# block, hand-maintained, and the two are kept aligned by eye. Saying otherwise
# here would be a claim the code does not support.
#
# Shell-sourceable: `set -a; . infra/provision/versions.env; set +a`

# Cloud Hypervisor uses the approved full fork revision and architecture
# checksums below; it is not selected by an upstream release-version pin.

# Cloud Hypervisor fork source and locally built artifact identities.
# The repository is a source location only; provisioning never downloads a
# release binary. The revision must match vendors/cloud-hypervisor.
CLOUD_HYPERVISOR_FORK_REPO="overdrive-sh/cloud-hypervisor"
CLOUD_HYPERVISOR_FORK_REV="f252bb20b0d141d59e4c15a9ac09c5c2dd7c350d"
CLOUD_HYPERVISOR_BUILD_TOOLCHAIN="1.89.0"
CLOUD_HYPERVISOR_SHA256_X86_64="6d54fbd2611e692fda00e476fc0723e9502bfd8acd53c8bc46edd96e84f3e842"
CLOUD_HYPERVISOR_SHA256_AARCH64="74195594db430695d4fbd9a8ecbc1d6d4b196f17c52afa6a3e96c967d86a91cc"

# virtiofsd comes from apt (Ubuntu ships 1.13.2), NOT a pinned download.
# It lands at /usr/libexec/virtiofsd and is NOT on $PATH — `which virtiofsd`
# returns nothing. Anything invoking it must use the absolute path.
VIRTIOFSD_BIN="/usr/libexec/virtiofsd"

# sparse Git commit. The distro's 0.6.4 package fails Linux 7.0's
# `checker-valid.sh` `__typeof_unqual__` probe; this upstream revision passes.
# Replace it when an available distro release passes that same probe.
SPARSE_COMMIT="c4640450b84718f4ec8f14138e5cb28256078f7b"

# Ubuntu 26.04's stock Linux 7.0 headers record CONFIG_PAHOLE_VERSION=131.
# Keep the module-build host on that matching pahole release so Kbuild does
# not emit a version warning. Update this with the kernel-header pin if that
# recorded version changes.
PAHOLE_PACKAGE_VERSION="1.31-2ubuntu1"

# NOTE: wasmtime and pwru are deliberately absent. Lima installs both; this box
# does not, because nothing in the microVM probes uses them. They were listed
# here briefly as dead variables, which implied the metal box got them. It does
# not — add them to common-system.sh first if that changes.
